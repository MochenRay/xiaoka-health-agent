# OpenClaw 配置（如使用 OpenClaw 部署）
# OPENCLAW_AGENT_ID=xiaoka
# TELEGRAM_BOT_TOKEN=your-bot-token-here

# 模型配置（如使用独立 API）
# MODEL_API_KEY=your-api-key
# MODEL_NAME=your-model-name

# Google Health API（如启用 Apple Health/HealthKit 数据同步）
# GOOGLE_HEALTH_CLIENT_ID=your-oauth-client-id
# GOOGLE_HEALTH_CLIENT_SECRET=your-oauth-client-secret
# GOOGLE_HEALTH_TOKEN_FILE=/absolute/local/ignored/path/google-health-token.json
